{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "nodes/ml_model/mlModel.schema.json",
    "description": "An ML_Model node represents a machine-learning model that can be used by Operators for inference.",
    "$defs": {
        "pgProperties": {
            "customBasePath": "moma_management.domain.node_properties.NodeProperties",
            "title": "MLModel",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Human-readable name of the ML model"
                },
                "type": {
                    "type": "string",
                    "description": "Type or family of the ML model (e.g. classification, LLM)"
                }
            },
            "required": [
                "name",
                "type"
            ],
            "unevaluatedProperties": true
        }
    }
}