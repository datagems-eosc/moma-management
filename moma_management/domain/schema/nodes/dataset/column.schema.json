{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "nodes/dataset/column.schema.json",
    "title": "Column",
    "$defs": {
        "pgProperties": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Column name"
                },
                "description": {
                    "type": "string",
                    "description": "Description of the column content"
                },
                "dataType": {
                    "type": "string",
                    "description": "Data type of the column"
                },
                "semanticType": {
                    "type": "string",
                    "description": "Inferred semantic type of the column content (e.g. 'country name', 'identifier'); empty string if not executed, 'unknown'/'error' as reserved sentinel values"
                },
                "column": {
                    "type": "string",
                    "description": "Column identifier within the source file"
                },
                "sample": {
                    "type": "array",
                    "items": {
                        "type": ["string", "number", "boolean", "null"]
                    },
                    "description": "Sample values from the column"
                },
                "type": {
                    "type": "string",
                    "description": "Vocabulary type annotation for the column (e.g. cr:Field)"
                }
            },
            "unevaluatedProperties": true
        }
    }
}