# Settings of the analytical pattern embedder's scripts. Copy to .env and fill in:
#     cp .env.example .env
#     uv run --env-file .env -m generate_dataset.main
# Only generate_dataset uses them; train.py and benchmark.py need none.

# The LLM that writes the dataset: any OpenAI-compatible API.
# Base URL of the API, without /chat/completions (for instance https://api.example.org/v1)
LLM_API_BASE=
# Model name. A LiteLLM-style prefix such as "openai/" is accepted and dropped.
LLM_API_MODEL=
# Leave empty if the API needs no key.
LLM_API_KEY=
# Set to false for an endpoint with a self-signed certificate.
LLM_SSL_VERIFY=true
