            "labels": ["Aptitude_Learning_Operator", "Operator"],
            "properties": {
                "name": "Aptitude Learning Operator (step 1)",
                "description": "Selects MCQ items matching the student's current estimated proficiency level for the given topic/subtopic.",
                "version": "1.0.0",
                "command": "select_aptitude_questions",
                "step": 1,
                "inputs": [
                    {"name": "student_id", "type": "number", "required": true, "default": ""},
                    {"name": "topic", "type": "string", "required": true, "default": ""},
                    {"name": "num_questions", "type": "number", "required": false, "default": 1},
                    {"name": "excluded_question_ids", "type": "array", "required": false, "default": []}
                ],
                "outputs": [
                    {"name": "questions_ids", "type": "array", "required": true, "default": []},
                    {"name": "excluded_question_ids", "type": "array", "required": true, "default": []}
                ]
            }
        },
