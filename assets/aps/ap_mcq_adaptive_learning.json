{
    "$schema": "../../moma_management/domain/schema/moma.schema.json",
    "nodes": [
        {
            "id": "69c6e807-f476-46d4-a64b-45e50fdb51b1",
            "labels": ["Analytical_Pattern"],
            "properties": {
                "name": "Adaptive MCQ Recommendation AP",
                "description": "Personalized progression of 5 MCQ tests for a beginner student (proficiency ~0.2) on a given topic/subtopic: Aptitude -> Aptitude -> Gap -> Performance -> Aptitude. The operator sequence itself is fixed/deterministic; it was computed offline, once, by an LLM orchestrator that is not part of this graph (see 'orchestration' property). Storing only the resolved sequence lets the same proven path be replayed for any student in this proficiency band without re-invoking the LLM.",
                "process": "recommend",
                "publishedDate": "2026-07-17",
                "orchestration": {
                    "producedBy": "LLM Orchestrator (offline pre-processing step, not part of this AP graph)",
                    "targetCohort": "beginner students, proficiency level ~0.2",
                    "decisionTrace": [
                        {"step": 1, "operator": "Aptitude_Learning"},
                        {"step": 2, "operator": "Aptitude_Learning"},
                        {"step": 3, "operator": "Gap_Learning"},
                        {"step": 4, "operator": "Performance_Learning"},
                        {"step": 5, "operator": "Aptitude_Learning"}
                    ]
                }
            }
        },
        {
            "id": "366d419d-1793-4fa7-97b4-ef407ad17e0d",
            "labels": ["JSON", "Data", "cr:FileObject"],
            "properties": {
                "name": "Student Context",
                "description": "Input context: which student, which topic/subtopic, and their starting proficiency estimate.",
                "contentUrl": "",
                "student_id": "",
                "topic": "",
                "proficiency_level": 0.2
            }
        },
        {
